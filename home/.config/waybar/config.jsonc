// Waybar: one thin bar at the top. Docs: man waybar, man waybar-<module>
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    // Same 6px as Hyprland's gaps_out, so the bar lines up with windows.
    "margin-top": 6,
    "margin-left": 6,
    "margin-right": 6,

    "modules-left":   ["ext/workspaces", "cpu", "memory"],
    "modules-center": ["clock"],
    "modules-right":  ["wireplumber", "network", "custom/keep-awake", "custom/notification", "group/tray-drawer"],

    // ext-workspace protocol: clicks go through Wayland, not hyprctl's
    // legacy dispatch syntax (which Hyprland 0.56 with a Lua config rejects).
    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-id": true,
        "ignore-hidden": true
    },

    "cpu": {
        "interval": 2,
        "format": "\uf2db  {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 2,
        "format": "\uefc5  {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "interval": 30
    },

    "wireplumber": {
        "format": "\uf028  {volume}%",
        "format-muted": "\uf026  muted",
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "tooltip-format": "{node_name}"
    },

    "network": {
        "interval": 5,
        "format-wifi": "\uf1eb {essid}",
        "format-ethernet": "\uf0e8 wired",
        "format-linked": "\uf0e8 no ip",
        "format-disconnected": "\uf127 offline",
        "tooltip-format": "{ifname}  {ipaddr}/{cidr}",
        "tooltip-format-wifi": "{ifname}  {ipaddr}/{cidr}  {signalStrength}%"
    },

    // Coffee cup. Click holds a systemd idle inhibitor so hypridle does not
    // lock, blank or suspend. Colour comes from style.css (.on vs .off).
    "custom/keep-awake": {
        "exec": "keep-awake status",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "on": "\uf0f4",
            "off": "\uf0f4"
        },
        "interval": 2,
        "signal": 8,
        "on-click": "keep-awake toggle; pkill -SIGRTMIN+8 waybar",
        "tooltip": true
    },

    // swaync: left click opens the panel, right click toggles do-not-disturb.
    "custom/notification": {
        "exec": "swaync-client -swb",
        "exec-if": "command -v swaync-client",
        "return-type": "json",
        "escape": true,
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "none": "\uf0a2",
            "notification": "\uf0f3",
            "dnd-none": "\uf1f7",
            "dnd-notification": "\uf1f6",
            "inhibited-none": "\uf0a2",
            "inhibited-notification": "\uf0f3",
            "dnd-inhibited-none": "\uf1f7",
            "dnd-inhibited-notification": "\uf1f6"
        },
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    },

    // First module stays visible. Click it to reveal the tray icons.
    "group/tray-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 150,
            "click-to-reveal": true,
            "transition-left-to-right": false
        },
        "modules": [
            "custom/tray-icon",
            "tray"
        ]
    },

    "custom/tray-icon": {
        "format": "\uf01c",
        "tooltip": false
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    }
}
