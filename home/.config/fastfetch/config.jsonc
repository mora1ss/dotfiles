// Compact fastfetch: small logo, seven lines, ANSI colours only
// (follows the terminal palette). Docs: fastfetch --help, `fastfetch --gen-config-full`
{
    "logo": {
        "source": "CachyOS_old_small",
        "padding": { "top": 0, "left": 1, "right": 2 }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "blue",
            "title": "magenta"
        },
        "key": {
            "width": 8
        }
    },
    "modules": [
        { "type": "os",       "key": "os" },
        { "type": "kernel",   "key": "kernel" },
        { "type": "wm",       "key": "wm" },
        { "type": "shell",    "key": "shell" },
        { "type": "terminal", "key": "term" },
        { "type": "uptime",   "key": "uptime" },
        { "type": "memory",   "key": "memory" }
    ]
}
